# Copy this file to .env and adjust. Never commit .env.

# Provider: ollama (the only one implemented)
LLM_PROVIDER=ollama
# Model name; defaults to qwen3:8b for Ollama
LLM_MODEL=qwen3:8b

# Ollama settings
OLLAMA_BASE_URL=http://localhost:11434
# Reasoning on makes the 8B model call tools reliably, but answers take longer
LLM_REASONING=true
OLLAMA_NUM_CTX=8192

# Embeddings model for the store manual search (Ollama; run: ollama pull bge-m3)
EMBEDDING_MODEL=bge-m3
